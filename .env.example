# Puerto HTTP del contenedor / proceso
PORT=3000

# Carpeta de datos (dentro del contenedor es el volumen montado)
DATA_DIR=/data

# Limite de tamano por archivo, en MB
MAX_FILE_SIZE_MB=500

# Tope de vida de un enlace, en minutos (24 h)
MAX_TTL_MINUTES=1440

# Vida por defecto de un enlace, en minutos (2 h)
DEFAULT_TTL_MINUTES=120

# URL publica con la que se arma el QR. Obligatoria detras de un tunnel o
# reverse proxy: sin esto el QR puede apuntar a un host interno.
# Ej: https://share.tudominio.com
PUBLIC_BASE_URL=

# Rate limiting de /api/upload
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=15
